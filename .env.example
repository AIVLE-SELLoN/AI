# 이 파일을 .env 로 복사해서 값을 채우세요. .env 는 git 에 올라가지 않습니다.
#   cp .env.example .env

# --- LLM (OpenAI) ---
LLM_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=60

# --- LLM 추적 (LangSmith) --- 비워두면 추적 비활성 (에러 안 남, 그냥 안 됨)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_PROJECT=sellon-agent3

# --- 벡터DB (ChromaDB) ---
CHROMA_HOST=localhost
CHROMA_PORT=8000
# 로컬 파일 모드로 쓸 때만 사용. 값이 있으면 HOST/PORT 대신 이 경로를 씁니다.
CHROMA_PERSIST_DIR=.chroma

# --- Kafka (docker-compose) ---
# 브로커 EXTERNAL 리스너가 광고할 호스트. EC2 배포 시 Elastic IP 를 넣는다.
# 로컬에서만 띄울 땐 비워두면 localhost 로 동작.
KAFKA_EXTERNAL_HOST=localhost

# EC2(Linux)에서 컨테이너가 root 로 만든 data/raw.db 를 호스트 워커가 못 열 때만 사용.
# docker-compose.yml 의 mock-producer `user:` 줄을 함께 열어야 적용된다.
#DOCKER_UID=1000
#DOCKER_GID=1000

# --- 분류 워커 (scripts/classification_worker.py) ---
# 워커는 Kafka 가 아니라 아래 raw DB 를 읽는다. mock_producer 의 --raw-db 와 같은 경로여야 함.
RAW_DB_PATH=./data/raw.db
# 한 번에 분류할 원문 건수. 1건 = LLM 1콜이라 그대로 과금량이다.
BATCH_SIZE=10
# --follow 로 돌 때 새 원본을 확인하는 주기(초).
POLL_INTERVAL_SECONDS=5
# 커서(어디까지 읽었는지)를 저장하는 키. 워커를 여러 개 띄울 때만 다르게 준다.
CLASSIFICATION_WORKER_ID=classification-worker-1

# --- 보고서 S3 적재 (app/reporting/s3_uploader.py) ---
# 실제 업로드(boto3)가 붙기 전까지는 false. 켜면 업로드하지 않고도 "성공"을 반환하므로
# boto3 연동이 끝난 뒤에만 true 로 바꿀 것.
S3_ENABLED=false
# 버킷은 하나. 문서 종류는 프리픽스(monthly-report/ · cs-guideline/)로 가르고
# Lifecycle 규칙도 프리픽스 단위로 건다 (인프라 「S3 파일 구조 규칙 정의」).
S3_BUCKET_NAME=sellon-reports
# 고객사 PK/UUID. 경로가 reports/companies/{company_id}/... 로 회사 단위로 갈린다.
# 비워두면 업로드가 실패한다 — 모르는 채로 임의 경로에 올리지 않는다.
S3_COMPANY_ID=

# --- RabbitMQ 발행 (app/core/mq.py · docs/mq_events.md) ---
# false 면 발행 함수가 MqDisabledError 를 던진다. no-op 이 아닌 이유: 호출부가 예외
# 없음을 발행 성공으로 보고 알림을 캐시에 넣어서, 조용히 넘기면 안 나간 알림이 7일간
# 억제된다.
MQ_ENABLED=false
# 운영 접속 정보는 백엔드 대기 중(C1). 로컬 검증은 docker-compose 의 rabbitmq 로 한다:
#   docker compose up -d rabbitmq
#   MQ_ENABLED=true MQ_HOST=localhost MQ_USER=sellon MQ_PASSWORD=sellon
MQ_HOST=localhost
MQ_PORT=5672
MQ_USER=sellon
MQ_PASSWORD=sellon
# 운영 vhost 는 /app 이다 (MQ 컨벤션 §2.1 CRD). 로컬 docker-compose 는 / 를 쓴다.
MQ_VHOST=/app
# Envelope 의 companyId. 배포마다 고정값이고 백엔드가 "하드코딩으로 박아두라"고 했다.
# **비어 있으면 발행이 막힌다** — 회사 미상 데이터가 백엔드 DB 에 쌓이는 걸 막기 위해서다.
# ⚠️ 실제 값은 백엔드 대기 중 (예시의 SLN-xxxxxxxxxx 는 자리표시자).
MQ_COMPANY_ID=
# 단일 Topic Exchange. 라우팅 키(ai.# / feedback.#)로 분기한다 (mq_events.md §1).
MQ_EXCHANGE=app.events
MQ_PUBLISH_TIMEOUT_SECONDS=10
# exchange·큐를 우리가 만들지, 이미 있는 걸 쓸지. 운영 토폴로지는 백엔드 인프라 소유라
# **운영에서는 반드시 false** — 우리가 다른 설정으로 선언하면 PRECONDITION_FAILED 로
# 거부당해 발행도 수신도 못 뜬다. 로컬 docker-compose 처럼 빈 브로커에서만 true.
# ⚠️ 로컬에서 true 로 켰다면 `python scripts/setup_local_mq.py` 도 한 번 돌릴 것 —
#    큐(main.inbound·ai.inbound)는 운영에서 백엔드가 만들기 때문에 우리 코드가 안 만든다.
#    없으면 발행이 전부 unroutable 로 실패한다.
MQ_DECLARE_TOPOLOGY=false

# --- 앱 ---
LOG_LEVEL=INFO
