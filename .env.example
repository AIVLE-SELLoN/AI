# 이 파일을 .env 로 복사해서 값을 채우세요. .env 는 git 에 올라가지 않습니다.
#   cp .env.example .env

# --- LLM (OpenAI) ---
LLM_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=60

# --- LLM 추적 (LangSmith) --- 비워두면 추적 비활성 (에러 안 남, 그냥 안 됨)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_PROJECT=sellon-agent3

# --- 벡터DB (ChromaDB) ---
CHROMA_HOST=localhost
CHROMA_PORT=8000
# 로컬 파일 모드로 쓸 때만 사용. 값이 있으면 HOST/PORT 대신 이 경로를 씁니다.
CHROMA_PERSIST_DIR=.chroma

# --- Kafka (docker-compose) ---
# 브로커 EXTERNAL 리스너가 광고할 호스트. EC2 배포 시 Elastic IP 를 넣는다.
# 로컬에서만 띄울 땐 비워두면 localhost 로 동작.
KAFKA_EXTERNAL_HOST=localhost

# EC2(Linux)에서 컨테이너가 root 로 만든 data/raw.db 를 호스트 워커가 못 열 때만 사용.
# docker-compose.yml 의 mock-producer `user:` 줄을 함께 열어야 적용된다.
#DOCKER_UID=1000
#DOCKER_GID=1000

# --- 분류 워커 (scripts/classification_worker.py) ---
# 워커는 Kafka 가 아니라 아래 raw DB 를 읽는다. mock_producer 의 --raw-db 와 같은 경로여야 함.
RAW_DB_PATH=./data/raw.db
# 한 번에 분류할 원문 건수. 1건 = LLM 1콜이라 그대로 과금량이다.
BATCH_SIZE=10
# --follow 로 돌 때 새 원본을 확인하는 주기(초).
POLL_INTERVAL_SECONDS=5
# 커서(어디까지 읽었는지)를 저장하는 키. 워커를 여러 개 띄울 때만 다르게 준다.
CLASSIFICATION_WORKER_ID=classification-worker-1

# --- 보고서 S3 적재 (app/reporting/s3_uploader.py) ---
# 실제 업로드(boto3)가 붙기 전까지는 false. 켜면 업로드하지 않고도 "성공"을 반환하므로
# boto3 연동이 끝난 뒤에만 true 로 바꿀 것.
S3_ENABLED=false
# 버킷은 하나. 문서 종류는 프리픽스(monthly-report/ · cs-guideline/)로 가르고
# Lifecycle 규칙도 프리픽스 단위로 건다 (인프라 「S3 파일 구조 규칙 정의」).
S3_BUCKET_NAME=sellon-reports
# 고객사 PK/UUID. 경로가 reports/companies/{company_id}/... 로 회사 단위로 갈린다.
# 비워두면 업로드가 실패한다 — 모르는 채로 임의 경로에 올리지 않는다.
S3_COMPANY_ID=

# --- 앱 ---
LOG_LEVEL=INFO
