# 줄바꿈 정규화 — 저장소에는 LF 로 저장하고, 체크아웃은 OS 관례를 따른다.
#
# 왜 필요한가: Windows 에서 파일을 통째로 다시 쓰는 도구(파이썬 Path.write_text 등)가
# LF 를 CRLF 로 바꿔 놓으면, 실제로는 몇 줄만 고쳤는데 **파일 전체가 변경**으로 잡힌다.
# 공유 파일(app/core/*)에서 그러면 blame 이 팀 전체에 영향을 준다.
# 실제로 PR #28 에서 .env.example 11줄 수정이 93줄로, constants.py 15줄이 467줄로 부풀었다.
#
# ⚠️ 기존 파일 중 CRLF 로 커밋된 것들이 있다(app/core/schemas.py 등). 이 설정만으로는
#    바뀌지 않고, 그 파일을 **다음에 고치는 사람**의 커밋에서 통째로 정규화된다.
#    한 번에 정리하려면 `git add --renormalize .` 를 **별도 커밋**으로 올려야 하는데,
#    모든 팀원의 파일을 건드리므로 팀 합의 후 진행할 것.

* text=auto

# 텍스트로 확정 (확장자로 판별이 애매한 것 방지)
*.py    text diff=python
*.md    text
*.json  text
*.yml   text
*.yaml  text
*.toml  text
*.csv   text
*.html  text
*.css   text
*.txt   text
.env.example text

# 셸 스크립트는 LF 여야 실행된다 (컨테이너·CI 에서 CRLF 면 깨진다)
*.sh    text eol=lf
Dockerfile text eol=lf

# ⚠️ ruff 기준선은 CI 가 `diff` 로 **바이트 단위 비교**하는 파일이라 개행도 계약이다.
#    이 줄이 없으면 윈도우에서 로컬 재현이 안 된다 —
#    `diff -u .github/ruff-baseline.txt <(ruff check . --statistics)` 가 내용이 같은데도
#    **13줄 전체 불일치**로 보인다(2026-08-18 실측. 리뷰어가 한 번 오판했고 이어서 나도 밟았다).
#
#    🔴 원인이 `core.autocrlf` 가 아니다 — 이 저장소는 `.git/config` 에서 `false` 로 꺼 두는데도
#       그대로 밟는다. 위 `*.txt text` 가 **명시적 text 속성**이라 autocrlf 와 무관하게 EOL
#       변환이 걸리고, 그때 쓰이는 `core.eol` 의 기본값이 `native`(윈도우=CRLF)여서다.
#       그래서 "autocrlf 껐으니 괜찮겠지" 는 여기서 안 통한다.
#
#    CI 는 리눅스라 native 가 LF 이므로 **CI 만 초록인 파일**이 되는 셈이라 더 헷갈린다.
#    `git archive` 도 이 속성을 따르므로 컨테이너로 재현할 때도 같이 맞는다.
.github/ruff-baseline.txt text eol=lf

# 바이너리 — 변환 금지
*.pdf   binary
*.png   binary
*.jpg   binary
*.ico   binary
*.db    binary
*.sqlite binary
*.xlsx  binary
